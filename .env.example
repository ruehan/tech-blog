# Gallery (사진첩) — set these in Vercel → Project → Settings → Environment Variables.
# Locally, leave them empty: the dev server uses PGlite (.local/pgdata), disk storage and no-login admin.

# Neon Postgres (Vercel Marketplace → Neon adds this automatically)
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=hangyu-photos
R2_PRIVATE_BUCKET=hangyu-photo-originals
# Public URL of the public bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=https://photos.hangyu.blog

# Admin login (GitHub OAuth App, callback https://hangyu.blog/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed into /admin
ADMIN_GITHUB_LOGINS=
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
